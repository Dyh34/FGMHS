.pingfen{position:relative;margin-left:5rpx;margin-top:10rpx;width:100%;border:#fff solid 2rpx;border-radius:2%;height:750rpx;background-color:#fff}.pingfen .ptitle{margin-left:5rpx;margin-top:20rpx;font-weight:600;font-size:29rpx}.pingfen .zhuangtai{justify-content:space-between;align-items:center;display:flex;flex-direction:row;margin-left:30rpx;margin-top:40rpx}.pingfen .zhuangtai .z1{display:flex;flex-direction:row}.pingfen .zhuangtai .z1 .z1a{font-size:60rpx;font-weight:700;color:green}.pingfen .zhuangtai .z1 .z1b{margin-top:38rpx;margin-left:7rpx}.pingfen .zhuangtai .z2{display:flex;justify-content:space-around;align-items:center;margin-right:60rpx;width:130rpx;height:40rpx;border-radius:100rpx;background-color:#e8f6ec}.pingfen .zhuangtai .z2 .z2a{font-size:18rpx;color:#6fb682;font-weight:500}.pingfen .tu{margin-top:20rpx;margin-left:30rpx;width:90%;height:500rpx}.pingfen .tu .radar-container{position:relative;width:100%;height:100%}.pingfen .tu .radar-container .radar-grid{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:360rpx;height:360rpx}.pingfen .tu .radar-container .radar-grid .radar-layer{position:absolute;top:0;left:0;width:100%;height:100%;border:2rpx solid #e0e0e0;border-radius:50%;transform-origin:center}.pingfen .tu .radar-container .radar-corner{position:absolute;text-align:center}.pingfen .tu .radar-container .radar-corner.top{top:-10%;left:50%;transform:translate(-50%)}.pingfen .tu .radar-container .radar-corner.right{top:40%;right:0;transform:translateY(-50%)}.pingfen .tu .radar-container .radar-corner.bottom-right{bottom:0;right:20%;transform:translate(50%)}.pingfen .tu .radar-container .radar-corner.bottom-left{bottom:0;left:20%;transform:translate(-50%)}.pingfen .tu .radar-container .radar-corner.left{top:40%;left:0;transform:translateY(-50%)}.pingfen .tu .radar-container .radar-item-box{padding:10rpx;background-color:rgba(255,255,255,.8);border-radius:8rpx;box-shadow:0 2rpx 4rpx rgba(0,0,0,.1)}.pingfen .tu .radar-container .radar-item-box .radar-label{font-size:24rpx;color:#333}.pingfen .tu .radar-container .radar-item-box .radar-value{font-size:28rpx;font-weight:600;color:#333;margin-top:8rpx}.pingfen .tu .radar-container .radar-polygon{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:360rpx;height:360rpx;background:rgba(99,168,255,.2);border:2rpx solid #63a8ff}.pingfen .tu .radar-container .radar-lines{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:360rpx;height:360rpx}.pingfen .tu .radar-container .radar-lines .radar-line{position:absolute;top:0;left:50%;width:2rpx;height:180rpx;background-color:#e0e0e0;transform-origin:bottom center}.pingfen .retry-overlay{position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(255,255,255,.85);display:flex;justify-content:center;align-items:center;z-index:10;border-radius:inherit}.pingfen .retry-box{display:flex;flex-direction:column;align-items:center}.pingfen .retry-icon{font-size:60rpx;margin-bottom:20rpx}.pingfen .retry-text{font-size:30rpx;color:#333;margin-bottom:12rpx;font-weight:500}.pingfen .retry-hint{font-size:24rpx;color:#888}
