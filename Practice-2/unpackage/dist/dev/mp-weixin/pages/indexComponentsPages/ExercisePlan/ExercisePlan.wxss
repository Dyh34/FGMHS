/* 文章场景相关 */
.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 30rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* 顶部 */
.header {
  margin-top: 40rpx;
  margin-bottom: 30rpx;
}
.header-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #222;
}
.header-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #888;
}

/* 今日卡片 */
.today-card {
  background: #eef8f1;
  border-radius: 34rpx;
  padding: 34rpx;
}
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #222;
}
.card-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
}

/* 圆 */
.step-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #5ebf7b;
}

/* 进度 */
.progress-bg {
  height: 16rpx;
  background: #dbeedf;
  border-radius: 20rpx;
  margin-top: 34rpx;
  overflow: hidden;
}
.progress-inner {
  width: 65%;
  height: 100%;
  background: #8ed6a3;
  border-radius: 20rpx;
}

/* 数据 */
.data-row {
  display: flex;
  justify-content: space-between;
  margin-top: 34rpx;
}
.data-item {
  flex: 1;
  text-align: center;
}
.data-value {
  font-size: 34rpx;
  font-weight: bold;
  color: #222;
}
.data-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #888;
}

/* 区块 */
.section-card {
  margin-top: 30rpx;
  background: white;
  border-radius: 34rpx;
  padding: 30rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #222;
  margin-bottom: 24rpx;
}

/* 计划 */
.plan-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f3f3;
}
.plan-item:last-child {
  border: none;
}
.plan-left {
  display: flex;
  align-items: center;
}
.plan-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: #f4faf5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}
.plan-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #222;
}
.plan-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
}

/* tag */
.plan-tag {
  padding: 10rpx 20rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
}
.done-tag {
  background: #edf8f0;
  color: #5ebf7b;
}
.wait-tag {
  background: #f4f4f4;
  color: #888;
}

/* 推荐训练 */
.train-scroll {
  white-space: nowrap;
}
.train-row {
  display: flex;
}
.train-card {
  width: 240rpx;
  background: #f8faf8;
  border-radius: 30rpx;
  padding: 28rpx;
  margin-right: 20rpx;
  box-sizing: border-box;
}
.train-icon {
  font-size: 52rpx;
}
.train-name {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #222;
}
.train-time {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #888;
}

/* AI建议 */
.ai-card {
  margin-top: 30rpx;
  background: #f2f8f4;
  border-radius: 34rpx;
  padding: 32rpx;
}
.ai-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222;
}
.ai-content {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #666;
}

/* 按钮 */
.start-btn {
  height: 92rpx;
  background: #8ed6a3;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 40rpx;
}