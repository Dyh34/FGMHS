/* 文章场景相关 */
.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 顶部 */
.header {
  margin-top: 40rpx;
}
.header-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #222;
}
.header-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #888;
}

/* 今日推荐 */
.today-card {
  margin-top: 30rpx;
  background: #f3f8f4;
  border-radius: 36rpx;
  padding: 34rpx;
}
.today-top {
  display: flex;
  align-items: center;
}
.today-tag {
  padding: 8rpx 18rpx;
  background: #dff0e4;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #67b57b;
  font-weight: bold;
}
.today-date {
  margin-left: 18rpx;
  font-size: 24rpx;
  color: #888;
}
.today-title {
  margin-top: 26rpx;
  font-size: 38rpx;
  font-weight: bold;
  color: #222;
  line-height: 54rpx;
}
.today-content {
  margin-top: 22rpx;
  font-size: 28rpx;
  line-height: 46rpx;
  color: #666;
}
.today-footer {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.today-type {
  padding: 10rpx 18rpx;
  background: white;
  border-radius: 18rpx;
  font-size: 22rpx;
  color: #67b57b;
}
.today-read {
  font-size: 22rpx;
  color: #999;
}

/* 分类 */
.tab-scroll {
  margin-top: 30rpx;
  white-space: nowrap;
}
.tab-row {
  display: flex;
}
.tab-item {
  padding: 18rpx 34rpx;
  background: white;
  border-radius: 24rpx;
  margin-right: 18rpx;
  font-size: 26rpx;
  color: #666;
}
.active-tab {
  background: #dff0e4;
  color: #67b57b;
  font-weight: bold;
}

/* 列表 */
.tips-list {
  margin-top: 30rpx;
}

/* 卡片 */
.tip-card {
  background: white;
  border-radius: 32rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tip-left {
  flex: 1;
  padding-right: 20rpx;
}
.tip-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222;
  line-height: 46rpx;
}
.tip-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #777;
  line-height: 42rpx;
}
.tip-bottom {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}
.tip-type {
  padding: 8rpx 18rpx;
  background: #f3f8f4;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #67b57b;
}
.tip-time {
  margin-left: 20rpx;
  font-size: 22rpx;
  color: #aaa;
}

/* 图标 */
.tip-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: #f7faf7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

/* AI */
.ai-card {
  margin-top: 20rpx;
  background: #eef7f1;
  border-radius: 34rpx;
  padding: 34rpx;
  margin-bottom: 50rpx;
}
.ai-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #222;
}
.ai-content {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 46rpx;
  color: #666;
}