/* 文章场景相关 */
.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding-bottom: 40rpx;
}

/* 顶部 */
.header {
  padding: 60rpx 36rpx 50rpx;
  background: linear-gradient(135deg, #6dd27c, #49b96e);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  color: white;
}
.header-title {
  font-size: 48rpx;
  font-weight: bold;
}
.header-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

/* 卡片 */
.card {
  margin: 30rpx;
  background: white;
  border-radius: 30rpx;
  padding: 30rpx;
  box-shadow: 0 6rpx 30rpx rgba(0, 0, 0, 0.05);
}
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #222;
}
.card-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #777;
}

/* 标签 */
.tag {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.green {
  background: #e8f8ec;
  color: #4caf50;
}
.orange {
  background: #fff3df;
  color: #ff9800;
}

/* 功能列表 */
.feature-list {
  margin-top: 28rpx;
}
.feature-item {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #555;
}

/* 按钮 */
.main-btn {
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 30rpx;
  font-weight: bold;
  margin-top: 30rpx;
}
.green-bg {
  background: #4caf50;
}
.orange-bg {
  background: linear-gradient(135deg, #ffb74d, #ff9800);
}

/* 医生信息 */
.doctor-box {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}
.doctor-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #eee;
}
.doctor-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #222;
}
.doctor-job {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #777;
}
.doctor-score {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #ff9800;
}

/* 服务 */
.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 30rpx;
}
.service-item {
  background: #f7f8fb;
  border-radius: 22rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #555;
}

/* 价格 */
.price-box {
  display: flex;
  align-items: flex-end;
  margin-top: 30rpx;
}
.price {
  font-size: 54rpx;
  font-weight: bold;
  color: #ff9800;
}
.price-text {
  font-size: 24rpx;
  color: #888;
  margin-left: 14rpx;
  margin-bottom: 8rpx;
}

/* section */
.section {
  margin: 30rpx;
  background: white;
  border-radius: 30rpx;
  padding: 30rpx;
  box-shadow: 0 6rpx 30rpx rgba(0, 0, 0, 0.04);
}
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #222;
  margin-bottom: 30rpx;
}

/* 工具 */
.tool-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}
.tool-item {
  background: #f8f9fc;
  border-radius: 24rpx;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tool-icon {
  font-size: 48rpx;
}
.tool-text {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #555;
}

/* 最近记录 */
.record-card {
  background: #f8f9fc;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.record-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.record-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #222;
}
.record-time {
  font-size: 22rpx;
  color: #999;
}
.record-content {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 42rpx;
}