/* 文章场景相关 */
.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding-bottom: 40rpx;
}

/* 顶部 */
.top-bg {
  padding: 70rpx 34rpx 120rpx;
  background: linear-gradient(135deg, #6fd08c, #43b96e);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}
.page-title {
  font-size: 52rpx;
  font-weight: bold;
  color: white;
}
.page-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 卡片 */
.doctor-card {
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  background: white;
  border-radius: 34rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
}
.ai-card {
  margin-top: -70rpx;
}

/* header */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #222;
}
.card-subtitle {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #888;
}

/* tag */
.tag {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
}
.green-tag {
  background: #e9f8ec;
  color: #45b96f;
}
.orange-tag {
  background: #fff4e4;
  color: #ff9800;
}

/* feature */
.feature-box {
  margin-top: 30rpx;
}
.feature-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #4caf50;
  margin-right: 16rpx;
}
.feature-text {
  font-size: 28rpx;
  color: #555;
}

/* ai提醒 */
.ai-tip-box {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #f6fbf7;
  border-radius: 24rpx;
}
.tip-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.tip-content {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 42rpx;
  color: #666;
}

/* 按钮 */
.main-btn {
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
  color: white;
  margin-top: 30rpx;
}
.green-btn {
  background: #49b96e;
}
.orange-btn {
  background: linear-gradient(135deg, #ffb84d, #ff9800);
}

/* 医生 */
.real-doctor-box {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
}
.doctor-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #eee;
  margin-right: 24rpx;
}
.doctor-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #222;
}
.doctor-job {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #888;
}
.doctor-score {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #ff9800;
}

/* 服务 */
.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 34rpx;
}
.service-item {
  background: #f8f9fc;
  border-radius: 24rpx;
  padding: 26rpx;
  display: flex;
  align-items: center;
}
.service-icon {
  font-size: 40rpx;
}
.service-name {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #555;
}

/* 家庭共享 */
.family-share-box {
  margin-top: 30rpx;
  padding: 24rpx;
  background: #fff8ef;
  border-radius: 24rpx;
}
.family-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff9800;
}
.family-content {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 42rpx;
  color: #666;
}

/* 联系 */
.contact-box {
  display: flex;
  margin-top: 30rpx;
  gap: 20rpx;
}
.contact-btn {
  flex: 1;
  height: 82rpx;
  background: #49b96e;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 28rpx;
  font-weight: bold;
}
.white-btn {
  background: #f5f7fb;
  color: #555;
}

/* 价格 */
.price-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
}
.price-left {
  display: flex;
  align-items: flex-end;
}
.price {
  font-size: 58rpx;
  font-weight: bold;
  color: #ff9800;
}
.price-desc {
  margin-left: 10rpx;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #888;
}
.share-tag {
  padding: 10rpx 18rpx;
  background: #fff4e4;
  color: #ff9800;
  border-radius: 20rpx;
  font-size: 22rpx;
}