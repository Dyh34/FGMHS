.page{height:100vh;background:#f5f7fb;display:flex;flex-direction:column}.top-bar{padding:70rpx 30rpx 30rpx;background:#fff;display:flex;align-items:center;justify-content:space-between;box-shadow:0 4rpx 20rpx rgba(0,0,0,.04)}.group-name{font-size:38rpx;font-weight:700;color:#222}.group-desc{margin-top:10rpx;font-size:24rpx;color:#888}.top-btn{font-size:42rpx;color:#666}.chat-area{flex:1;padding:30rpx;box-sizing:border-box}.time-text{text-align:center;font-size:22rpx;color:#999;margin-bottom:30rpx}.message-row{display:flex;margin-bottom:34rpx}.left{justify-content:flex-start}.right{justify-content:flex-end}.avatar{width:84rpx;height:84rpx;border-radius:50%;background:#eee}.message-content{max-width:520rpx;margin-left:20rpx}.user-content{margin-left:0;margin-right:20rpx}.sender-name{font-size:22rpx;color:#999;margin-bottom:10rpx}.ai-name{color:#49b96e}.doctor-name{color:#ff9800}.message-bubble{padding:24rpx;border-radius:26rpx;font-size:28rpx;line-height:42rpx;word-break:break-all}.ai-bubble{background:#eaf8ee;color:#333;border-top-left-radius:8rpx}.doctor-bubble{background:#fff4e8;color:#333;border-top-left-radius:8rpx}.user-bubble{background:#49b96e;color:#fff;border-top-right-radius:8rpx}.tool-bar{padding:20rpx 24rpx;display:flex;background:#fff;border-top:1rpx solid #f0f0f0}.tool-btn{flex:1;height:72rpx;background:#f5f7fb;border-radius:20rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx;color:#555;margin:0 10rpx}.input-area{height:110rpx;background:#fff;display:flex;align-items:center;padding:0 24rpx;border-top:1rpx solid #f2f2f2}.input-icon{width:70rpx;height:70rpx;background:#f5f7fb;border-radius:18rpx;display:flex;align-items:center;justify-content:center;font-size:42rpx;color:#666}.chat-input{flex:1;height:74rpx;background:#f5f7fb;border-radius:22rpx;margin:0 20rpx;padding:0 24rpx;font-size:28rpx}.send-btn{width:110rpx;height:74rpx;background:#49b96e;border-radius:22rpx;display:flex;align-items:center;justify-content:center;color:#fff;font-size:28rpx;font-weight:700}
