<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.hjmd.homet.mapper.UserInfoMapper">
    <select id="getUserInfobyID" resultType="cn.hjmd.homet.entity.HealthDateVO">
        SELECT * from health_record where id = #{id}
    </select>

    <select id="getUserRecord" resultType="cn.hjmd.homet.entity.MedicalRecord">
        SELECT * from medical_record where user_id = #{id}
    </select>

</mapper>





